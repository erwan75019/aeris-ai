# Runtime
AERIS_ENVIRONMENT=development
AERIS_DATA_PROVIDER=demo
AERIS_CORS_ORIGINS=["http://localhost:3000"]

# Used by Docker Compose and future persistent repositories. The current demo
# provider remains deterministic and does not require the database.
AERIS_DATABASE_URL=postgresql+asyncpg://aeris:aeris@localhost:5432/aeris

# Server-side Next.js rewrite target. Never expose credentials to NEXT_PUBLIC_*.
AERIS_BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Optional external providers. Keep unset to run the fully offline demo.
AERIS_OPENSKY_CLIENT_ID=
AERIS_OPENSKY_CLIENT_SECRET=
AERIS_LLM_PROVIDER=
AERIS_LLM_MODEL=
